# PostgreSQL connection string (Neon-style, serverless Postgres).
# Get one at https://neon.tech — create a project, then copy the pooled
# connection string it gives you.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

SMS_PROVIDER=console        # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID= # reserved — not used by the current SMS_PROVIDER=twilio impl (see lib/sms/twilio.ts)
TWILIO_FROM_NUMBER=        # required for SMS_PROVIDER=twilio — a Twilio phone number to send from

NEXT_PUBLIC_INVEST_URL=     # external DAOProptech investment platform link
NEXT_PUBLIC_SITE_URL=       # canonical production URL, for OG/share preview image resolution
